
delete project rift

create project rift "A GLUE project for Rift Valley fever virus (RFV)" --minVersion 0.1.151

# Define project-specific DB schema extensions
schema-project rift
  run file schema/riftSchemaExtensions.glue
exit
 
# Build project
project rift

  run file glue/build/riftProjectSettings.glue  
  run file glue/build/riftModules.glue

  # Set log level
  console set log-level INFO

  # Set up M49 standard for country & region data
  run file glue/build/m49_countries/populateM49All.glue
  
  # Import the sequences
  import source sources/ncbi-refseqs-rift 
  import source sources/ncbi-core-rift

  # Delete patent-related sequences
  run script glue/build/riftDeletePatentRelatedSequences.js

  # Link all imported sequences to the isolate table
  run script glue/build/riftLinkSequencesToIsolates.js

  # Define the genome feature set
  run file glue/build/riftFeatures.glue

  # Declare master reference segment sequences & add feature locations on each
  run file glue/build/riftMasterReferences.glue

  # Load sequence-associated data from Genbank XML
  module riftGenbankXmlPopulator populate

  # Declare lineage references
  run script glue/build/loadRvfvLineages.js

  # Resolve isolate naming inconsistencies
  run script glue/build/riftResolveIsolateIds.js
    
  # Do segment recognition
  delete module riftSegmentRecogniser  
  create module --fileName modules/build/riftSegmentRecogniser.xml
  run script glue/build/riftRecogniseSegments.js

  # Flag complete genomes based on `rec_segment` and `isolate.isolate_id` fields
  run script glue/build/riftSetCompleteGenomes.js
  
  # Construct alignments and determine feature coverage
  #run file glue/build/riftAlignments.glue

  # Define alignment tree
  run file glue/build/riftAlignmentTree.glue

  validate
  
