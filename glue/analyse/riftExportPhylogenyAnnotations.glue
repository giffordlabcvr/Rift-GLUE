
  delete module riftFigTreeAnnotationExporter
  create module -f modules/analyse/riftFigTreeAnnotationExporter.xml
  
  # Export annotations
  module riftFigTreeAnnotationExporter 
  
  	export figtree-annotation AL_ROOT_SegS -f trees/AL_ROOT_SegS.annotations.tsv
  	export figtree-annotation AL_ROOT_SegM -f trees/AL_ROOT_SegM.annotations.tsv
  	export figtree-annotation AL_ROOT_SegL -f trees/AL_ROOT_SegL.annotations.tsv

    exit   

