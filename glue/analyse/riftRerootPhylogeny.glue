  delete module ervPhyloUtility
  
  create module -f modules/analyse/oasPhyloUtility.xml

  module oasPhyloUtility
  
	# midpoint rooting  
	reroot-phylogeny \
      --inputFile trees/oas1.tre NEWICK_BOOTSTRAPS \
      --midpoint \
      --outputFile trees/oas1Nucs_MidpointRerooted.tre NEWICK_BOOTSTRAPS

    exit   
