
  module riftFeaturePresenceRecorder 

	#~# Segment S

	record feature-presence AL_ROOT_SegS --recursive --featureName segment_s --descendentFeatures

	#~# Segment M

	record feature-presence AL_ROOT_SegM --recursive --featureName segment_m --descendentFeatures

	#~# Segment L

	record feature-presence AL_ROOT_SegL --recursive --featureName segment_l --descendentFeatures

	exit
	