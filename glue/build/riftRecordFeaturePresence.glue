
  module riftFeaturePresenceRecorder 

	#~# Segment S

	record feature-presence AL_ROOT_SegS --recursive --featureName whole_genome --descendentFeatures

	#~# Segment M

	record feature-presence AL_ROOT_SegM --recursive --featureName whole_genome --descendentFeatures

	#~# Segment L

	record feature-presence AL_ROOT_SegL --recursive --featureName whole_genome --descendentFeatures

	exit
	