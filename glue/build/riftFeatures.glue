 
  #~#~# RNA Segments
 
  create feature segment_s "Segment S"
  feature segment_s set field displayName "Segment S"
  feature segment_s set metatag INCLUDE_IN_SUMMARY true
  
  create feature segment_m "Segment M"
  feature segment_m set field displayName "Segment M"
  feature segment_m set metatag INCLUDE_IN_SUMMARY true
  
  create feature segment_l "Segment L"
  feature segment_l set field displayName "Segment L"
  feature segment_l set metatag INCLUDE_IN_SUMMARY true

  #~#~# Segment S
  
  create feature NSs -p segment_s "non-structural protein"
  feature NSs 
    set metatag OWN_CODON_NUMBERING true
    set metatag INCLUDE_IN_SUMMARY true
    set metatag CODES_AMINO_ACIDS true
    exit
    
  create feature NP -p segment_s "nucleocapsid"
  feature NP 
    set metatag OWN_CODON_NUMBERING true
    set metatag INCLUDE_IN_SUMMARY true
    set metatag CODES_AMINO_ACIDS true
	set metatag REVERSE_COMPLEMENT_TRANSLATION true
    exit
    
  #~#~# Segment M
  
  create feature Gn -p segment_m "glycoprotein"
  feature Gn 
    set metatag OWN_CODON_NUMBERING true
    set metatag INCLUDE_IN_SUMMARY true
    set metatag CODES_AMINO_ACIDS true
    exit

  #~#~# Segment L
  
  create feature L -p segment_l "polymerase"
  feature L 
    set metatag OWN_CODON_NUMBERING true
    set metatag INCLUDE_IN_SUMMARY true
    set metatag CODES_AMINO_ACIDS true
    exit



