  
  create feature whole_genome "Whole genome"
  feature whole_genome set field displayName "Whole genome"
  feature whole_genome set metatag INCLUDE_IN_SUMMARY true


  #~#~# Segment 1
  
  create feature NSs -p whole_genome "non-structural protein"
  feature NSs set metatag OWN_CODON_NUMBERING true
  feature NSs set metatag INCLUDE_IN_SUMMARY true
  feature NSs set metatag CODES_AMINO_ACIDS true
  
  create feature NP -p whole_genome "nucleocapsid"
  feature NP set metatag OWN_CODON_NUMBERING true
  feature NP set metatag INCLUDE_IN_SUMMARY true
  feature NP set metatag CODES_AMINO_ACIDS true


  #~#~# Segment 2
  
  create feature Gn -p whole_genome "glycoprotein"
  feature Gn set metatag OWN_CODON_NUMBERING true
  feature Gn set metatag INCLUDE_IN_SUMMARY true
  feature Gn set metatag CODES_AMINO_ACIDS true


  #~#~# Segment 3
  
  create feature L -p whole_genome "polymerase"
  feature L set metatag OWN_CODON_NUMBERING true
  feature L set metatag INCLUDE_IN_SUMMARY true
  feature L set metatag CODES_AMINO_ACIDS true



