    extract child AL_S_2a --refName REF_S_A_ZH-1776
    demote member AL_S_2a --whereClause "sequence.rec_segment = 'S' and sequence.rec_lineage in ('D','F','H','A','B') and sequence.source.name = 'ncbi-core-rift' and sequence.isolate.is_reference = TRUE"

    exit

