    extract child AL_L_2 --refName REF_L_A_ZH-1776
    demote member AL_L_2 --whereClause "sequence.rec_segment = 'L' and sequence.rec_lineage in ('G','E','C','F','D','H','A','B') and sequence.source.name = 'ncbi-core-rift' and sequence.isolate.is_reference = TRUE"

