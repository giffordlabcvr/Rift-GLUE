### RVFV lineage alignment tree
###
### One constrained alignment hierarchy per segment (S, L, M).
### Node structure follows the >= 0.90 support clades from the
### midpoint-rooted reference-genotype trees.
###
### Members are selected as:
###   sequence.rec_segment = '<S|L|M>'
###   and sequence.rec_lineage in (...)
###   and sequence.source.name = 'ncbi-core-rift'   # exclude masters
###   and sequence.isolate.is_reference = TRUE


  delete alignment AL_LINEAGE_TREE_SegS
  delete alignment AL_LINEAGE_TREE_SegM
  delete alignment AL_LINEAGE_TREE_SegL

  create alignment AL_LINEAGE_TREE_SegS -r REF_S_MASTER 
  create alignment AL_LINEAGE_TREE_SegM -r REF_M_MASTER 
  create alignment AL_LINEAGE_TREE_SegL -r REF_L_MASTER 

  alignment AL_LINEAGE_TREE_SegS add member -w "rec_segment = 'S' and isolate.is_reference = TRUE"
  alignment AL_LINEAGE_TREE_SegM add member -w "rec_segment = 'M' and isolate.is_reference = TRUE"
  alignment AL_LINEAGE_TREE_SegL add member -w "rec_segment = 'L' and isolate.is_reference = TRUE"
  
  
#
# =========================================================================
# SEGMENT S
# =========================================================================
#

alignment AL_LINEAGE_TREE_SegS

    extract child AL_S_1 --refName REF_S_A_ZH-1776
    demote member AL_S_1 --whereClause "sequence.rec_segment = 'S' and sequence.rec_lineage in ('I','O','J','K','M','L','N') and sequence.source.name = 'ncbi-core-rift' and sequence.isolate.is_reference = TRUE"

    extract child AL_S_2 --refName REF_S_A_ZH-1776
    demote member AL_S_2 --whereClause "sequence.rec_segment = 'S' and sequence.rec_lineage in ('C','E','G','D','F','H','A','B') and sequence.source.name = 'ncbi-core-rift' and sequence.isolate.is_reference = TRUE"

    exit

alignment AL_S_1

    extract child AL_S_1a --refName REF_S_K_B314
    demote member AL_S_1a --whereClause "sequence.rec_segment = 'S' and sequence.rec_lineage in ('K','M') and sequence.source.name = 'ncbi-core-rift' and sequence.isolate.is_reference = TRUE"

    exit

