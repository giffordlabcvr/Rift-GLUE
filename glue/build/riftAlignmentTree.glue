### RVFV lineage alignment tree
###
### Two-level hierarchy per segment:
###   Root (AL_LINEAGE_TREE_Seg<S/L/M>) -> major clades -> lineage clades
###
### One reference per lineage; masters stay at the root only.
###
###   sequence.rec_segment = '<S|L|M>'
###   and sequence.rec_lineage in (...)
###   and sequence.source.name = 'ncbi-core-rift'    # exclude masters
###   and sequence.isolate.is_reference = TRUE


# -----------------------------------------------------------------------------
# Create roots and add all reference members
# -----------------------------------------------------------------------------

create alignment AL_LINEAGE_TREE_SegS -r REF_S_MASTER
alignment AL_LINEAGE_TREE_SegS
    set field displayName "RVFV Segment S lineage tree"
    add member --whereClause "rec_segment = 'S' and rec_lineage != NULL and source.name = 'ncbi-core-rift'"
    exit

create alignment AL_LINEAGE_TREE_SegM -r REF_M_MASTER
alignment AL_LINEAGE_TREE_SegM
    set field displayName "RVFV Segment M lineage tree"
    add member --whereClause "rec_segment = 'M' and rec_lineage != NULL and source.name = 'ncbi-core-rift'"
    exit

create alignment AL_LINEAGE_TREE_SegL -r REF_L_MASTER
alignment AL_LINEAGE_TREE_SegL
    set field displayName "RVFV Segment L lineage tree"
    add member --whereClause "rec_segment = 'L' and rec_lineage != NULL and source.name = 'ncbi-core-rift'"
    exit


# =============================================================================
# SEGMENT S
# =============================================================================

alignment AL_LINEAGE_TREE_SegS

    extract child AL_S_1 -r REF_S_A_ZH-1776
    demote member AL_S_1 --whereClause "sequence.rec_segment = 'S' and sequence.rec_lineage in ('I','O','J','K','M','L','N') and sequence.source.name = 'ncbi-core-rift'"

    extract child AL_S_2 -r REF_S_A_ZH-1776
    demote member AL_S_2 --whereClause "sequence.rec_segment = 'S' and sequence.rec_lineage in ('C','E','G','D','F','H','A','B') and sequence.source.name = 'ncbi-core-rift'"

    exit

alignment AL_S_1
    set field displayName "S-1"
    set field clade_category "major_clade"

    extract child AL_S_I -r REF_S_I_Ar74
    demote member AL_S_I --whereClause "sequence.rec_segment = 'S' and sequence.rec_lineage = 'I' and sequence.source.name = 'ncbi-core-rift'"

    extract child AL_S_O -r REF_S_O_M1955
    demote member AL_S_O --whereClause "sequence.rec_segment = 'S' and sequence.rec_lineage = 'O' and sequence.source.name = 'ncbi-core-rift'"

    extract child AL_S_J -r REF_S_J_2269_74
    demote member AL_S_J --whereClause "sequence.rec_segment = 'S' and sequence.rec_lineage = 'J' and sequence.source.name = 'ncbi-core-rift'"

    extract child AL_S_K -r REF_S_K_B314
    demote member AL_S_K --whereClause "sequence.rec_segment = 'S' and sequence.rec_lineage = 'K' and sequence.source.name = 'ncbi-core-rift'"

    extract child AL_S_M -r REF_S_M_M259_09
    demote member AL_S_M --whereClause "sequence.rec_segment = 'S' and sequence.rec_lineage = 'M' and sequence.source.name = 'ncbi-core-rift'"

    extract child AL_S_L -r REF_S_L_56_74_4255
    demote member AL_S_L --whereClause "sequence.rec_segment = 'S' and sequence.rec_lineage = 'L' and sequence.source.name = 'ncbi-core-rift'"

    extract child AL_S_N -r REF_S_N_HD21955
    demote member AL_S_N --whereClause "sequence.rec_segment = 'S' and sequence.rec_lineage = 'N' and sequence.source.name = 'ncbi-core-rift'"

    exit

alignment AL_S_2
    set field displayName "S-2"
    set field clade_category "major_clade"

    extract child AL_S_C -r REF_S_C_200803168
    demote member AL_S_C --whereClause "sequence.rec_segment = 'S' and sequence.rec_lineage = 'C' and sequence.source.name = 'ncbi-core-rift'"

    extract child AL_S_E -r REF_S_E_74HB59
    demote member AL_S_E --whereClause "sequence.rec_segment = 'S' and sequence.rec_lineage = 'E' and sequence.source.name = 'ncbi-core-rift'"

    extract child AL_S_G -r REF_S_G_ANK-6087
    demote member AL_S_G --whereClause "sequence.rec_segment = 'S' and sequence.rec_lineage = 'G' and sequence.source.name = 'ncbi-core-rift'"

    extract child AL_S_D -r REF_S_D_73HB1230
    demote member AL_S_D --whereClause "sequence.rec_segment = 'S' and sequence.rec_lineage = 'D' and sequence.source.name = 'ncbi-core-rift'"

    extract child AL_S_F -r REF_S_F_Ar20364
    demote member AL_S_F --whereClause "sequence.rec_segment = 'S' and sequence.rec_lineage = 'F' and sequence.source.name = 'ncbi-core-rift'"

    extract child AL_S_H -r REF_S_H_SA67_11
    demote member AL_S_H --whereClause "sequence.rec_segment = 'S' and sequence.rec_lineage = 'H' and sequence.source.name = 'ncbi-core-rift'"

    extract child AL_S_A -r REF_S_A_ZH-1776
    demote member AL_S_A --whereClause "sequence.rec_segment = 'S' and sequence.rec_lineage = 'A' and sequence.source.name = 'ncbi-core-rift'"

    extract child AL_S_B -r REF_S_B_S35
    demote member AL_S_B --whereClause "sequence.rec_segment = 'S' and sequence.rec_lineage = 'B' and sequence.source.name = 'ncbi-core-rift'"

    exit

