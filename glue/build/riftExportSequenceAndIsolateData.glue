
console set cmd-output-file-format tab

console set next-cmd-output-file tabular/sequenceAndIsolateData.tsv

list sequence sequenceID segment pubmed_id length full_name gb_ref_journal gb_ref_title \
              gb_ref_doi gb_create_date isolate.id isolate.iso_country isolate.iso_region \
              isolate.iso_year isolate.iso_month isolate.iso_day isolate.origin_type \
              isolate.sample_type isolate.iso_host isolate.iso_source \
              isolate.m49_country.id isolate.m49_country.m49_sub_region.id  \
              isolate.m49_country.m49_intermediate_region.id \
              isolate.m49_country.m49_sub_region.id \
              isolate.m49_country.m49_intermediate_region.id \
              isolate.m49_country.development_status
