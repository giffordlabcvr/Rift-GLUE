
  delete module riftFigTreeAnnotationExporter
  create module -f modules/analyse/riftFigTreeAnnotationExporter.xml
  
  # Export annotations
  module riftFigTreeAnnotationExporter 
  
  	export figtree-annotation AL_UNC_LINEAGE_TREE_SegS -f trees/genotyper/AL_UNC_LINEAGE_TREE_SegS.annotations.tsv
  	export figtree-annotation AL_UNC_LINEAGE_TREE_SegM -f trees/genotyper/AL_UNC_LINEAGE_TREE_SegM.annotations.tsv
  	export figtree-annotation AL_UNC_LINEAGE_TREE_SegL -f trees/genotyper/AL_UNC_LINEAGE_TREE_SegL.annotations.tsv

    exit   

