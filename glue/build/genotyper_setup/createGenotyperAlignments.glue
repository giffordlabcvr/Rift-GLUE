  delete alignment AL_UNC_LINEAGE_TREE_SegS
  delete alignment AL_UNC_LINEAGE_TREE_SegM
  delete alignment AL_UNC_LINEAGE_TREE_SegL

  create alignment AL_UNC_LINEAGE_TREE_SegS  
  create alignment AL_UNC_LINEAGE_TREE_SegM 
  create alignment AL_UNC_LINEAGE_TREE_SegL
  
  alignment AL_UNC_LINEAGE_TREE_SegS add member \
			-w "rec_segment = 'S' and rec_lineage != NULL and source.name = 'ncbi-core-rift'"
  
  alignment AL_UNC_LINEAGE_TREE_SegM add member \
			-w "rec_segment = 'M' and rec_lineage != NULL and source.name = 'ncbi-core-rift'"
  
  alignment AL_UNC_LINEAGE_TREE_SegL add member \
			-w "rec_segment = 'L' and rec_lineage != NULL and source.name = 'ncbi-core-rift'"
			
  compute alignment AL_UNC_LINEAGE_TREE_SegS riftMafftAligner
  compute alignment AL_UNC_LINEAGE_TREE_SegM riftMafftAligner
  compute alignment AL_UNC_LINEAGE_TREE_SegL riftMafftAligner 

