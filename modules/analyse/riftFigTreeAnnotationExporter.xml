<figTreeAnnotationExporter>

	<figTreeAnnotation>
		<annotationName>sequenceID</annotationName>
		<valueFreemarkerTemplate>${renderNestedProperty('sequence.sequenceID')}</valueFreemarkerTemplate>
	</figTreeAnnotation>

	<figTreeAnnotation>
		<annotationName>pubmed_id</annotationName>
		<valueFreemarkerTemplate>${renderNestedProperty('sequence.pubmed_id')}</valueFreemarkerTemplate>
	</figTreeAnnotation>

	<figTreeAnnotation>
		<annotationName>length</annotationName>
		<valueFreemarkerTemplate>${renderNestedProperty('sequence.length')}</valueFreemarkerTemplate>
	</figTreeAnnotation>

	<figTreeAnnotation>
		<annotationName>gb_lineage</annotationName>
		<valueFreemarkerTemplate>${renderNestedProperty('sequence.gb_lineage')}</valueFreemarkerTemplate>
	</figTreeAnnotation>
	
	<figTreeAnnotation>
		<annotationName>iso_host</annotationName>
		<valueFreemarkerTemplate>${renderNestedProperty('sequence.isolate.iso_host')}</valueFreemarkerTemplate>
	</figTreeAnnotation>
	
	<figTreeAnnotation>
		<annotationName>m49_country</annotationName>
		<valueFreemarkerTemplate>${renderNestedProperty('sequence.isolate.m49_country.id')}</valueFreemarkerTemplate>
	</figTreeAnnotation>

	<figTreeAnnotation>
		<annotationName>m49_country_region</annotationName>
		<valueFreemarkerTemplate>${renderNestedProperty('sequence.isolate.m49_country.m49_region.id')}</valueFreemarkerTemplate>
	</figTreeAnnotation>

	<figTreeAnnotation>
		<annotationName>m49_country_subregion</annotationName>
		<valueFreemarkerTemplate>${renderNestedProperty('sequence.isolate.m49_country.m49_sub_region.id')}</valueFreemarkerTemplate>
	</figTreeAnnotation>

	<figTreeAnnotation>
		<annotationName>development_status</annotationName>
		<valueFreemarkerTemplate>${renderNestedProperty('sequence.isolate.m49_country.development_status')}</valueFreemarkerTemplate>
	</figTreeAnnotation>
	
	<figTreeAnnotation>
		<annotationName>iso_source</annotationName>
		<valueFreemarkerTemplate>${renderNestedProperty('sequence.isolate.iso_source')}</valueFreemarkerTemplate>
	</figTreeAnnotation>

	<figTreeAnnotation>
		<annotationName>strain_and_isolate_info</annotationName>
		<valueFreemarkerTemplate>${renderNestedProperty('sequence.isolate.isolate_id')} | ${renderNestedProperty('sequence.isolate.gb_strain')} | ${renderNestedProperty('sequence.isolate.gb_isolate')}</valueFreemarkerTemplate>
	</figTreeAnnotation>

	<figTreeAnnotation>
		<annotationName>sample_type</annotationName>
		<valueFreemarkerTemplate>${renderNestedProperty('sequence.isolate.sample_type')}</valueFreemarkerTemplate>
	</figTreeAnnotation>

	<figTreeAnnotation>
		<annotationName>origin_type</annotationName>
		<valueFreemarkerTemplate>${renderNestedProperty('sequence.isolate.origin_type')}</valueFreemarkerTemplate>
	</figTreeAnnotation>

	<figTreeAnnotation>
		<annotationName>iso_year</annotationName>
		<valueFreemarkerTemplate>${renderNestedProperty('sequence.isolate.iso_year')}</valueFreemarkerTemplate>
	</figTreeAnnotation>
	
	<figTreeAnnotation>
		<annotationName>combined1</annotationName>
		<valueFreemarkerTemplate>${renderNestedProperty('sequence.isolate.m49_country.m49_sub_region.id')} | ${renderNestedProperty('sequence.isolate.m49_country.id')} | ${renderNestedProperty('sequence.isolate.iso_year')} | ${renderNestedProperty('sequence.isolate.iso_host')}</valueFreemarkerTemplate>
	</figTreeAnnotation>

	<figTreeAnnotation>
		<annotationName>combined2</annotationName>
		<valueFreemarkerTemplate>${renderNestedProperty('sequence.isolate.isolate_id')} | ${renderNestedProperty('sequence.isolate.m49_country.m49_sub_region.id')} | ${renderNestedProperty('sequence.isolate.m49_country.id')} | ${renderNestedProperty('sequence.isolate.iso_year')} | ${renderNestedProperty('sequence.isolate.iso_host')} | ${renderNestedProperty('sequence.complete_genome')}</valueFreemarkerTemplate>
	</figTreeAnnotation>


</figTreeAnnotationExporter>

