<maxLikelihoodGenotyper>
	<maxLikelihoodPlacerModuleName>riftMaxLikelihoodPlacerSegL</maxLikelihoodPlacerModuleName>
	<cladeCategory>
		<name>major_clade</name>	
		<displayName>Major clade</displayName>	
		<whereClause>clade_category = 'major_clade'</whereClause>
		<distanceScalingExponent>-4.5</distanceScalingExponent>
		<distanceCutoff>0.015</distanceCutoff>
		<finalCladeCutoff>75.0</finalCladeCutoff>
	</cladeCategory>
	
	<cladeCategory>
		<name>lineage</name>	
		<displayName>Lineage</displayName>	
		<whereClause>clade_category = 'lineage'</whereClause>
		<distanceScalingExponent>-5.5</distanceScalingExponent>
	    <distanceCutoff>0.008</distanceCutoff>
		<finalCladeCutoff>61.0</finalCladeCutoff>
	</cladeCategory>
</maxLikelihoodGenotyper>