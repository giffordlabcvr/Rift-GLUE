<genbankXmlPopulator>

	<gbOrganism>
		<propertyPopulator property="full_name">
		</propertyPopulator>
	</gbOrganism>

	<gbLength>
		<propertyPopulator property="length"/>
	</gbLength>

	<gbDivision>
		<propertyPopulator property="patent_related">
			<matchPattern>PAT</matchPattern>
			<outputTemplate>true</outputTemplate>
		</propertyPopulator>
	</gbDivision>

	<gbReference>
		<gbRefPubmed>
			<propertyPopulator property="pubmed_id"/>
		</gbRefPubmed>

		<gbRefJournal>
			<propertyPopulator property="gb_ref_journal"/>
		</gbRefJournal>

		<gbRefDoi>
			<propertyPopulator property="gb_ref_doi"/>
		</gbRefDoi>

		<gbRefTitle>
			<propertyPopulator property="gb_ref_title"/>
		</gbRefTitle>

	</gbReference>
		
	<gbCreateDate>
		<propertyPopulator property="gb_create_date"/>
	</gbCreateDate>

	<gbUpdateDate>
		<propertyPopulator property="gb_update_date"/>
	</gbUpdateDate>


	
	<gbFeature key="source">
			
		
		<gbQualifier name="isolation_source">
			<propertyPopulator property="isolate.iso_source"/>
		</gbQualifier>

		<gbQualifier name="strain">
			<propertyPopulator property="isolate.gb_strain"/>
		</gbQualifier>		

		<gbQualifier name="isolate">
			<propertyPopulator property="isolate.gb_isolate"/>
		</gbQualifier>


		<gbQualifier name="note">
			<propertyPopulator property="gb_lineage">
				<matchPattern>(?i).*genotype\s*[:=\-]?\s*([A-Za-z0-9]+).*</matchPattern>
				<outputTemplate>${g1?upper_case}</outputTemplate>
			</propertyPopulator>
		</gbQualifier>		

		<gbQualifier name="note">
			<propertyPopulator property="gb_lineage">
				<matchPattern>(?i).*lineage\s*[:=\-]?\s*([A-Za-z0-9]+).*</matchPattern>
				<outputTemplate>${g1?upper_case}</outputTemplate>
			</propertyPopulator>
		</gbQualifier>

		<gbQualifier name="note">
			<propertyPopulator property="gb_lineage">
				<matchPattern>(?i).*clade\s*[:=\-]?\s*([A-Za-z0-9]+).*</matchPattern>
				<outputTemplate>${g1?upper_case}</outputTemplate>
			</propertyPopulator>
		</gbQualifier>
				
        <!-- Segment details -->

		<gbQualifier name="chromosome">
			<propertyPopulator property="segment">
				<matchPattern>(?i)^\s*([LMS])\s+segment\s*$</matchPattern>
				<outputTemplate>${g1?upper_case}</outputTemplate>
			</propertyPopulator>
		</gbQualifier>

		<gbQualifier name="segment">
			<propertyPopulator property="segment">
				<matchPattern>(?i)^\s*([LMS])\s*$</matchPattern>
				<outputTemplate>${g1?upper_case}</outputTemplate>
			</propertyPopulator>
		</gbQualifier>

		<gbQualifier name="gene">
			<propertyPopulator property="segment">
				<matchPattern>(?i)^\s*([LMS])\s*$</matchPattern>
				<outputTemplate>${g1?upper_case}</outputTemplate>
			</propertyPopulator>
		</gbQualifier>

		<gbQualifier name="map">
			<propertyPopulator property="segment">
				<matchPattern>(?i)^\s*([LMS])\s+segment\s*$</matchPattern>
				<outputTemplate>${g1?upper_case}</outputTemplate>
			</propertyPopulator>
		</gbQualifier>
					
        <!-- Isolate details -->

		<gbQualifier name="geo_loc_name">
			<propertyPopulator property="isolate.iso_country">
				<matchPattern>([^:]+)</matchPattern>
				<outputTemplate>${g1}</outputTemplate>
			</propertyPopulator>
			<propertyPopulator property="isolate.iso_region">
				<matchPattern>^.*:(.*)$</matchPattern>
				<outputTemplate>${g1?trim}</outputTemplate>
			</propertyPopulator>
			<isoCountryPropertyPopulator property="isolate.m49_country" codeStyle="ALPHA_3">
			


			</isoCountryPropertyPopulator>
		</gbQualifier>

		<gbQualifier name="host">
		
			<propertyPopulator property="isolate.iso_host">
			
				<!-- #### Human -->																																									
				<valueConverter>
					<matchPattern>.*Homo [sS]apiens.*</matchPattern>
					<matchPattern>.*[hH]uman.*</matchPattern>
					<outputTemplate>Homo sapiens</outputTemplate>
				</valueConverter>
				
				<!-- #### Ruminants -->	
				<valueConverter>
					<matchPattern>.*[bB]ovine.*</matchPattern>
					<matchPattern>.*[cC]attle.*</matchPattern>
					<matchPattern>.*[cC]ow.*</matchPattern>
					<matchPattern>.*Bos [tT]aurus.*</matchPattern>
					<outputTemplate>Bos taurus</outputTemplate>
				</valueConverter>

				<valueConverter>
					<matchPattern>.*[sS]heep.*</matchPattern>
					<matchPattern>.*\b[oO]vine\b.*</matchPattern>
					<matchPattern>.*Ovis [aA]ries.*</matchPattern>
					<outputTemplate>Ovis aries</outputTemplate>
				</valueConverter>

				<valueConverter>
					<matchPattern>.*[gG]oat.*</matchPattern>
					<matchPattern>.*[cC]aprine.*</matchPattern>
					<matchPattern>.*Capra.*</matchPattern>
					<outputTemplate>Capra sp.</outputTemplate>
				</valueConverter>

				<valueConverter>
					<matchPattern>.*[bB]uffalo.*</matchPattern>
					<matchPattern>.*[aA]frican buffalo.*</matchPattern>
					<matchPattern>.*Synceres [cC]affer.*</matchPattern>
					<matchPattern>.*Syncerus [cC]affer.*</matchPattern>
					<outputTemplate>Syncerus caffer</outputTemplate>
				</valueConverter>

				<!-- ### Additional Ruminants/Camelids-->
				
				<valueConverter>
					<matchPattern>.*[cC]amel.*</matchPattern>
					<matchPattern>.*Camelus.*</matchPattern>
					<outputTemplate>Camelus sp.</outputTemplate>
				</valueConverter>

				<valueConverter>
					<matchPattern>.*[sS]pringbok.*</matchPattern>
					<outputTemplate>Antidorcas marsupialis (springbok)</outputTemplate>
				</valueConverter>

				<valueConverter>
   					<matchPattern>.*[aA]lpaca.*</matchPattern>
   					<outputTemplate>Vicugna pacos</outputTemplate>
   				</valueConverter>

				<!-- ### Additional unknowns-->
				<valueConverter>
					   <matchPattern>[bB]ats?</matchPattern>
					<outputTemplate>Bat (unknown)</outputTemplate>
				</valueConverter>

				<valueConverter>
					<matchPattern>[mM]osquitoe?s?</matchPattern>
					<outputTemplate>Mosquito (unknown)</outputTemplate>
				</valueConverter>

				<valueConverter>
   					<matchPattern>.*[bB]iting [mM]idges.*</matchPattern>
					<matchPattern>.*[mM]idges.*</matchPattern>
					<matchPattern>.*[mM]idge.*</matchPattern>
   					<outputTemplate>Midge (unknown)</outputTemplate>
   				</valueConverter>

				<valueConverter>
   					<matchPattern>[aA]nimals?</matchPattern>
   					<outputTemplate>Animal (unknown)</outputTemplate>
   				</valueConverter>

   				<valueConverter>
   					<matchPattern>.*[tT]ick.*</matchPattern>
   					<outputTemplate>Tick (unknown)</outputTemplate>
   				</valueConverter>


				<!-- ### Cross-reference these with "lab_constructs.tsv"-->
				<valueConverter>
					<matchPattern>.*[vV]ero cells.*</matchPattern>
					<outputTemplate>lab_cell_line</outputTemplate>
				</valueConverter>
				



									
			</propertyPopulator>
			
		</gbQualifier>
		
		<gbQualifier name="collection_date">
			<propertyPopulator property="isolate.iso_day">
				<matchPattern>(\d{2})-[A-Za-z]{3}-\d{4}</matchPattern>
				<outputTemplate>${g1}</outputTemplate>
			</propertyPopulator>
			<propertyPopulator property="isolate.iso_month">
				<matchPattern>\d{2}-([A-Za-z]{3})-\d{4}</matchPattern>
				<outputTemplate>${g1?upper_case}</outputTemplate>
			</propertyPopulator>
			<propertyPopulator property="isolate.iso_year">
				<matchPattern>(\d{4})</matchPattern>
				<outputTemplate>${g1}</outputTemplate>
			</propertyPopulator>
		</gbQualifier>
		
		
		
	</gbFeature>
	
	
</genbankXmlPopulator>