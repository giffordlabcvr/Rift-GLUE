<genbankXmlPopulator>

	<gbOrganism>
		<propertyPopulator property="full_name">
		</propertyPopulator>
	</gbOrganism>

	<gbLength>
		<propertyPopulator property="length"/>
	</gbLength>

	<gbDivision>
		<propertyPopulator property="patent_related">
			<matchPattern>PAT</matchPattern>
			<outputTemplate>true</outputTemplate>
		</propertyPopulator>
	</gbDivision>

	<gbReference>
		<gbRefPubmed>
			<propertyPopulator property="pubmed_id"/>
		</gbRefPubmed>

		<gbRefJournal>
			<propertyPopulator property="gb_ref_journal"/>
		</gbRefJournal>

		<gbRefDoi>
			<propertyPopulator property="gb_ref_doi"/>
		</gbRefDoi>

		<gbRefTitle>
			<propertyPopulator property="gb_ref_title"/>
		</gbRefTitle>

	</gbReference>
		
	<gbCreateDate>
		<propertyPopulator property="gb_create_date"/>
	</gbCreateDate>

	<gbUpdateDate>
		<propertyPopulator property="gb_update_date"/>
	</gbUpdateDate>


	
	<gbFeature key="source">
			
		<gbQualifier name="isolate">
			<propertyPopulator property="isolate.isolate_id"/>
		</gbQualifier>
		
		<gbQualifier name="isolation_source">
			<propertyPopulator property="isolate.iso_source"/>
		</gbQualifier>

		<gbQualifier name="note">
			<propertyPopulator property="genotype">
				<matchPattern>(?i).*genotype\s*:\s*([AB]).*</matchPattern>
				<outputTemplate>${g1?upper_case}</outputTemplate>
			</propertyPopulator>
		</gbQualifier>
						
		<gbQualifier name="geo_loc_name">
			<propertyPopulator property="isolate.iso_country">
				<matchPattern>([^:]+)</matchPattern>
				<outputTemplate>${g1}</outputTemplate>
			</propertyPopulator>
			<propertyPopulator property="isolate.iso_region">
				<matchPattern>^.*:(.*)$</matchPattern>
				<outputTemplate>${g1?trim}</outputTemplate>
			</propertyPopulator>
			<isoCountryPropertyPopulator property="isolate.m49_country" codeStyle="ALPHA_3">
			
				<valueConverter>
					<matchPattern>.*Korea.*</matchPattern>
					<outputTemplate>KOR</outputTemplate>
				</valueConverter>
				<valueConverter>
					<matchPattern>.*U.S. Virgin Islands.*</matchPattern>
					<outputTemplate>VIR</outputTemplate>
				</valueConverter>
				<valueConverter>
					<matchPattern>.*Virgin Islands: Saint John.*</matchPattern>
					<outputTemplate>VIR</outputTemplate>
				</valueConverter>
				<valueConverter>
					<matchPattern>.*Wallis and Futuna.*</matchPattern>
					<outputTemplate>WLF</outputTemplate>
				</valueConverter>
				<valueConverter>
					<matchPattern>.*Saint Barthelemy.*</matchPattern>
					<outputTemplate>BLM</outputTemplate>
				</valueConverter>
				<valueConverter>
					<matchPattern>.*East Timor.*</matchPattern>
					<outputTemplate>TLS</outputTemplate>
				</valueConverter>
				<valueConverter>
					<matchPattern>.*Borneo.*</matchPattern>
					<outputTemplate>MYS</outputTemplate>
				</valueConverter>
				<valueConverter>
					<matchPattern>.*Saint Martin.*</matchPattern>
					<outputTemplate>MAF</outputTemplate>
				</valueConverter>
				<valueConverter>
					<matchPattern>.*Saint Vincent and the Grenadines.*</matchPattern>
					<outputTemplate>VCT</outputTemplate>
				</valueConverter>
				<valueConverter>
					<matchPattern>Virgin Islands</matchPattern>
					<outputTemplate>VGB</outputTemplate>
				</valueConverter>
				<valueConverter>
					<matchPattern>Pacific Ocean</matchPattern>
					<outputTemplate>VUT</outputTemplate>
				</valueConverter>


			</isoCountryPropertyPopulator>
		</gbQualifier>

		<gbQualifier name="host">
		
			<propertyPopulator property="isolate.iso_host">
			
				<!-- #### Environmental -->																																									
				<valueConverter>
					<matchPattern>.*[eE]nvironment.*</matchPattern>
					<matchPattern>.*[eE]nviornment.*</matchPattern>
					<matchPattern>.*[eE]nviroment.*</matchPattern>
					<matchPattern>.*[eE]nviorment.*</matchPattern>
					<matchPattern>.*[fF]eces.*</matchPattern>
					<matchPattern>.*[eE]nvironmental [sS]wab.*</matchPattern>
					<matchPattern>.*[eE]nvironment [sS]wab.*</matchPattern>
					<matchPattern>.*[eE]nvironmental [wW]ater.*</matchPattern>
					<matchPattern>.*ENVIRONMENT.*</matchPattern>
					<matchPattern>.*^ENV$.*</matchPattern>
					<matchPattern>.*^U$.*</matchPattern>
					<matchPattern>.*^[uU]nknown$.*</matchPattern>
					<outputTemplate>Environment</outputTemplate>
				</valueConverter>


				<!-- #### Reverse genetics -->																																									
				<valueConverter>
					<matchPattern>.*Reverse Genetics.*</matchPattern>
					<matchPattern>.*reverse genetic.*</matchPattern>
					<outputTemplate>Reverse Genetics</outputTemplate>
				</valueConverter>


				<!-- #### Human -->																																									
				<valueConverter>
					<matchPattern>.*Homo [sS]apiens.*</matchPattern>
					<matchPattern>.*homo sapiens 24 year-old female.*</matchPattern>
					<matchPattern>.*homo sapiens; age 25; gender F.*</matchPattern>
					<matchPattern>.*hom sapiens.*</matchPattern>
					<matchPattern>.*[hH]uman.*</matchPattern>
					<outputTemplate>Homo sapiens</outputTemplate>
				</valueConverter>
				

									
			</propertyPopulator>
			
		</gbQualifier>
		
		<gbQualifier name="collection_date">
			<propertyPopulator property="isolate.iso_day">
				<matchPattern>(\d{2})-[A-Za-z]{3}-\d{4}</matchPattern>
				<outputTemplate>${g1}</outputTemplate>
			</propertyPopulator>
			<propertyPopulator property="isolate.iso_month">
				<matchPattern>\d{2}-([A-Za-z]{3})-\d{4}</matchPattern>
				<outputTemplate>${g1?upper_case}</outputTemplate>
			</propertyPopulator>
			<propertyPopulator property="isolate.iso_year">
				<matchPattern>(\d{4})</matchPattern>
				<outputTemplate>${g1}</outputTemplate>
			</propertyPopulator>
		</gbQualifier>
		
		
		
	</gbFeature>
	
	
</genbankXmlPopulator>